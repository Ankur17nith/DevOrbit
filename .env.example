# ==============================================================================
# DevOrbit — Environment Configuration Template (.env.example)
# "Your Skills. Your Code. Your Opportunities. One Universe."
#
# INSTRUCTIONS:
# Copy this file to .env before starting the backend application:
#   cp .env.example .env
#
# DO NOT COMMIT REAL SECRETS OR ACCESS TOKENS TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# ------------------------------------------------------------------------------

# PORT
# Purpose: The HTTP port on which the Express API server listens.
# Required: Optional (defaults to 3001)
# Format: Positive integer (1024-65535)
# Secret: No
PORT=3001

# NODE_ENV
# Purpose: Operating environment mode ('development', 'production', 'test').
# Required: Optional (defaults to 'development')
# Format: string enum ('development' | 'production' | 'test')
# Secret: No
NODE_ENV=development

# CORS_ORIGIN
# Purpose: Whitelisted Origin header for browser Cross-Origin Resource Sharing.
# Required: Optional (defaults to 'http://localhost:5173')
# Format: URL string or comma-separated list
# Secret: No
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. LOCAL-FIRST DATABASE CONFIGURATION
# ------------------------------------------------------------------------------

# DATABASE_URL
# Purpose: SQLite connection string for Prisma ORM.
# Required: Required
# Format: "file:./devorbit.db" (relative to apps/api) or absolute file path
# Secret: No (path only, credentials not used for SQLite)
# Note: For production desktop packaging, points to $XDG_DATA_HOME/devorbit/devorbit.db
DATABASE_URL="file:./devorbit.db"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & CRYPTOGRAPHIC SECRETS
# ------------------------------------------------------------------------------

# JWT_SECRET
# Purpose: Cryptographic signing secret for user authentication JWT tokens.
# Required: Required in production (fallback generated with warning in development)
# Format: High-entropy string (minimum 32 characters / 256 bits recommended)
# Secret: YES - Critical Security Secret
# How to obtain: Run `openssl rand -hex 32` in terminal.
JWT_SECRET=devorbit-super-secure-local-jwt-signing-secret-key-32-chars-min

# INTEGRATION_ENCRYPTION_KEY
# Purpose: AES-256-GCM symmetric key used to encrypt GitHub PATs and OAuth tokens
#          at rest in the SQLite database before persistence.
# Required: Optional (defaults to SHA-256 derived key from JWT_SECRET)
# Format: 64-hex character string (32 bytes)
# Secret: YES - Critical Security Secret
# How to obtain: Run `openssl rand -hex 32` in terminal.
INTEGRATION_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 4. GITHUB INTEGRATION (OAUTH & PERSONAL ACCESS TOKENS)
# ------------------------------------------------------------------------------

# GITHUB_CLIENT_ID
# Purpose: Client ID of the GitHub OAuth Application for one-click web connection.
# Required: Optional (if omitted, DevOrbit gracefully falls back to Personal Access Tokens)
# Format: GitHub OAuth Client ID (e.g., Ov23li...)
# Secret: No
# How to obtain:
#   1. Go to https://github.com/settings/developers
#   2. Click "New OAuth App"
#   3. Set Authorization callback URL to: http://localhost:3001/api/v1/integrations/github/callback
GITHUB_CLIENT_ID=

# GITHUB_CLIENT_SECRET
# Purpose: Secret key corresponding to the GitHub OAuth Application.
# Required: Required if GITHUB_CLIENT_ID is provided
# Format: High-entropy alphanumeric string
# Secret: YES - Critical OAuth Secret
# How to obtain: Generated on the GitHub OAuth App settings page.
GITHUB_CLIENT_SECRET=

# GITHUB_REDIRECT_URI
# Purpose: OAuth redirect URI registered with GitHub.
# Required: Optional (defaults to http://localhost:3001/api/v1/integrations/github/callback)
# Format: Absolute URL matching GitHub OAuth App settings
# Secret: No
GITHUB_REDIRECT_URI=http://localhost:3001/api/v1/integrations/github/callback

# ------------------------------------------------------------------------------
# 5. LOCAL ORBIT AI ENGINE (OLLAMA INTEGRATION)
# ------------------------------------------------------------------------------

# OLLAMA_URL
# Purpose: HTTP address of the local Ollama LLM inference daemon.
# Required: Optional (defaults to http://127.0.0.1:11434)
# Format: HTTP URL
# Secret: No
# How to obtain:
#   1. Install Ollama: https://ollama.ai
#   2. Start daemon: `ollama serve`
#   3. Pull coding model: `ollama run deepseek-coder` or `ollama run qwen2.5-coder`
# Note: If Ollama is offline, DevOrbit automatically switches to its built-in
#       deterministic rule engine without crashing or making cloud calls.
OLLAMA_URL=http://127.0.0.1:11434

# ------------------------------------------------------------------------------
# 6. COMPETITIVE PROGRAMMING & DSA PLATFORM SETTINGS
# ------------------------------------------------------------------------------

# CODEFORCES_API_BASE
# Purpose: Base URL for Codeforces public REST API (user.info, user.rating, user.status).
# Required: Optional (defaults to https://codeforces.com/api)
# Format: HTTPS URL
# Secret: No
CODEFORCES_API_BASE=https://codeforces.com/api

# LEETCODE_GRAPHQL_ENDPOINT
# Purpose: Endpoint for public LeetCode user profile probes.
# Required: Optional (defaults to https://leetcode.com/graphql)
# Format: HTTPS URL
# Secret: No
LEETCODE_GRAPHQL_ENDPOINT=https://leetcode.com/graphql
