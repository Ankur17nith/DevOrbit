# ==============================================================================
# DevOrbit Monorepo — Environment Configuration Template (.env.example)
# "Your Skills. Your Code. Your Opportunities. One Universe."
#
# INSTRUCTIONS:
# Copy apps/api/.env.example to apps/api/.env to configure the Express backend and Prisma database:
#   cp apps/api/.env.example apps/api/.env
#
# Optionally copy apps/web/.env.example to apps/web/.env if customizing frontend Vite dev server settings:
#   cp apps/web/.env.example apps/web/.env
#
# DO NOT COMMIT REAL SECRETS OR ACCESS TOKENS TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# PORT
# Purpose: The HTTP port on which the Express API server listens.
# Required: Optional (defaults to 3001)
# Backend-only: Yes
PORT=3001

# NODE_ENV
# Purpose: Operating environment mode ('development', 'production', 'test').
# Required: Optional (defaults to 'development')
# Backend-only: Yes
NODE_ENV=development

# CORS_ORIGIN
# Purpose: Whitelisted Origin header for browser Cross-Origin Resource Sharing.
# Required: Optional (defaults to 'http://localhost:5173')
# In production: Cannot be wildcard (*)
# Backend-only: Yes
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. LOCAL-FIRST DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# DATABASE_URL
# Purpose: SQLite connection string for Prisma ORM.
# Required: Required for Prisma database push and Prisma client queries.
# Backend-only: Yes
DATABASE_URL="file:./devorbit.db"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & CRYPTOGRAPHIC SECRETS
# ------------------------------------------------------------------------------
# JWT_SECRET
# Purpose: Cryptographic signing secret for user authentication JWT tokens.
# Required: Required in production (minimum 32 characters)
# How to obtain: Run `openssl rand -hex 32`
# Backend-only: Yes
JWT_SECRET=devorbit-super-secure-local-jwt-signing-secret-key-32-chars-min

# GITHUB_TOKEN_ENCRYPTION_KEY
# Purpose: AES-256-GCM encryption key for encrypting GitHub OAuth tokens at rest.
# Required: Optional (falls back to JWT_SECRET in dev, recommended in production)
# Format: 32 bytes hex string (64 hexadecimal characters)
# How to obtain: Run `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# Backend-only: Yes
GITHUB_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 4. GITHUB APP / OAUTH CONFIGURATION
# ------------------------------------------------------------------------------
# Purpose: Enables production-grade GitHub App OAuth authorization with single-use
# anti-replay state validation, expiring token rotation, and repository synchronization.
# How to obtain: Create an OAuth App at https://github.com/settings/developers
# Callback URL: http://localhost:5173/integrations (or http://localhost:3001/api/v1/integrations/github/oauth/callback)
# Backend-only: Yes
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:5173/integrations

# ------------------------------------------------------------------------------
# 5. LOCAL AI & OLLAMA CONFIGURATION (OPTIONAL)
# ------------------------------------------------------------------------------
# OLLAMA_HOST
# Purpose: Host address for local Ollama LLM daemon (e.g. qwen2.5-coder, llama3).
# Required: Optional (defaults to http://127.0.0.1:11434).
# Backend-only: Yes
OLLAMA_HOST=http://127.0.0.1:11434

# ------------------------------------------------------------------------------
# 6. FRONTEND WEB CONFIGURATION
# ------------------------------------------------------------------------------
# VITE_API_URL
# Purpose: Base URL for frontend API requests.
# Note: In local dev, Vite automatically proxies /api to http://localhost:3001.
# If deploying separately or customizing API endpoints, set VITE_API_URL inside apps/web/.env.
# Optional (defaults to empty string in development)
# VITE_API_URL=http://localhost:3001

