datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// USER & AUTHENTICATION
// -------------------------------------------------------------

model User {
  id              String                  @id @default(uuid())
  email           String                  @unique
  username        String                  @unique
  passwordHash    String
  name            String?
  avatarUrl       String?
  bio             String?
  role            String                  @default("USER") // USER, ADMIN
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  sessions        Session[]
  preference      UserPreference?
  integrations    IntegrationCredential[]
  workspacesOwned Workspace[]             @relation("WorkspaceOwner")
  memberships     WorkspaceMembership[]
  bookmarks       UserBookmark[]
  dsaProgress     UserDsaProgress[]
  skillProfiles   UserSkillProfile[]
  githubRepos     UserGithubRepo[]
  contributionMetric UserContributionMetric?
  pipelineItems   ContributionPipelineItem[]
  selfbotConfigs  SelfbotConfig[]
  forumPosts      ForumPost[]
  forumReplies    ForumReply[]
  listings        MarketplaceListing[]
  conversations   AiConversation[]
  reconProjects   ReconProject[]
  notifications   Notification[]
  alertRules      AlertRule[]

  @@index([email])
  @@index([username])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model UserPreference {
  id             String   @id @default(uuid())
  userId         String   @unique
  theme          String   @default("dark") // dark, light, system
  ecoMode        Boolean  @default(true)
  notifyDesktop  Boolean  @default(true)
  notifyTelegram Boolean  @default(false)
  telegramChatId String?
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IntegrationCredential {
  id                     String    @id @default(uuid())
  userId                 String
  provider               String    // GITHUB, LEETCODE, CODEFORCES
  encryptedToken         String?
  encryptedRefreshToken String?
  tokenExpiresAt         DateTime?
  refreshTokenExpiresAt  DateTime?
  username               String?
  scopes                 String?   // e.g. "read:user,repo,read:org"
  rateLimitRemaining     Int?
  rateLimitReset         DateTime?
  rateLimitTotal         Int?
  lastSyncedAt           DateTime?
  metadataJson           String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model GithubOAuthState {
  id             String    @id @default(uuid())
  stateHash      String    @unique
  userId         String?
  browserBinding String?
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([stateHash])
  @@index([userId])
}

model UserGithubRepo {
  id              String    @id @default(uuid())
  userId          String
  githubRepoId    Int
  name            String
  fullName        String
  description     String?
  language        String?
  languagesJson   String?   // map of { "TypeScript": 140000, "Rust": 23000 }
  topicsJson      String?   // JSON array of topics
  stargazersCount Int       @default(0)
  forksCount      Int       @default(0)
  openIssuesCount Int       @default(0)
  isPrivate       Boolean   @default(false)
  isFork          Boolean   @default(false)
  defaultBranch   String    @default("main")
  license         String?
  pushedAt        DateTime?
  etag            String?
  syncedAt        DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, githubRepoId])
  @@index([userId])
  @@index([fullName])
}

model UserContributionMetric {
  id                  String   @id @default(uuid())
  userId              String   @unique
  totalCommits        Int      @default(0)
  totalPullRequests   Int      @default(0)
  mergedPullRequests  Int      @default(0)
  mergeRate           Float    @default(0.0) // 0.0 to 100.0%
  activeStreak        Int      @default(0)
  longestStreak       Int      @default(0)
  commitHeatmapJson   String?  // JSON array of 52-week activity points
  languageBytesJson   String?  // JSON map of aggregated language byte counts
  projectTimelineJson String?  // JSON array of recent commit/PR activities
  lastCalculatedAt    DateTime @default(now())

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// -------------------------------------------------------------
// WORKSPACES & COLLABORATION
// -------------------------------------------------------------

model Workspace {
  id          String                @id @default(uuid())
  name        String
  slug        String                @unique
  description String?
  ownerId     String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  owner       User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships WorkspaceMembership[]

  @@index([ownerId])
  @@index([slug])
}

model WorkspaceMembership {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  role        String    @default("MEMBER") // OWNER, ADMIN, MEMBER, VIEWER
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

// -------------------------------------------------------------
// ORBIT OSS: CATALOG, REPOSITORIES & ISSUES
// -------------------------------------------------------------

model OssRepository {
  id               String       @id @default(uuid())
  githubRepoId     Int?         @unique
  fullName         String       @unique // e.g. "facebook/react"
  name             String
  owner            String
  description      String?
  language         String?
  stargazersCount  Int          @default(0)
  forksCount       Int          @default(0)
  openIssuesCount  Int          @default(0)
  topicsJson       String?      // serialized JSON array
  license          String?
  defaultBranch    String       @default("main")
  lastPushedAt     DateTime?
  isClaimed        Boolean      @default(false)
  isVerified       Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  issues           OssIssue[]
  bookmarks        UserBookmark[]

  @@index([language])
  @@index([stargazersCount])
  @@index([fullName])
}

model OssIssue {
  id               String                    @id @default(uuid())
  githubIssueId    BigInt?                   @unique
  repositoryId     String
  number           Int
  title            String
  body             String?
  state            String                    @default("open")
  authorUsername   String?
  authorAvatarUrl  String?
  labelsJson       String?                   // JSON array of labels with colors
  difficulty       String?                   // beginner, intermediate, advanced
  isAssigned       Boolean                   @default(false)
  bountyAmount     String?                   // e.g. "500", "7k"
  currency         String?                   // USD, EUR, USDC
  url              String
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  repository       OssRepository             @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  pipelineItems    ContributionPipelineItem[]
  bookmarks        UserBookmark[]

  @@index([repositoryId])
  @@index([difficulty])
  @@index([state])
}

model OssProgram {
  id           String            @id @default(uuid())
  slug         String            @unique
  name         String
  description  String?
  website      String?
  category     String?           // GSOC, MENTORSHIP, HACKATHON
  timelineJson String?           // milestones & deadlines
  deadlineDate DateTime?
  status       String            @default("ACTIVE")
  createdAt    DateTime          @default(now())

  orgs         OssOrganization[]

  @@index([slug])
}

model OssOrganization {
  id                     String      @id @default(uuid())
  slug                   String      @unique
  name                   String
  description            String?
  website                String?
  logoUrl                String?
  technologiesJson       String?     // array of strings
  participationYearsJson String?     // array of years e.g. [2022, 2023, 2024]
  totalProjects          Int         @default(0)
  programId              String?
  createdAt              DateTime    @default(now())

  program                OssProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  bookmarks              UserBookmark[]

  @@index([slug])
  @@index([name])
}

model UserBookmark {
  id             String           @id @default(uuid())
  userId         String
  targetType     String           // REPO, ISSUE, GSOC_ORG, BOUNTY
  repositoryId   String?
  issueId        String?
  organizationId String?
  note           String?
  createdAt      DateTime         @default(now())

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository     OssRepository?   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  issue          OssIssue?        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  organization   OssOrganization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([targetType])
}

// -------------------------------------------------------------
// DSA INTELLIGENCE
// -------------------------------------------------------------

model DsaProblem {
  id            String            @id @default(uuid())
  externalId    String?
  platform      String            // LEETCODE, CODEFORCES, STRIVER_A2Z, TLE, TUF
  title         String
  slug          String
  canonicalSlug String?           // For cross-platform deduplication
  difficulty    String            // EASY, MEDIUM, HARD
  topic         String            // Array, String, Binary Tree, DP, Graph, etc.
  subtopic      String?
  tagsJson      String?           // serialized JSON array
  constraints   String?
  sheetCategory String?           // STRIVER_A2Z, BLIND_75, NEETCODE_150, CODEFORCES_DIV2, CUSTOM
  url           String
  createdAt     DateTime          @default(now())

  progress      UserDsaProgress[]

  @@unique([platform, slug])
  @@index([difficulty])
  @@index([topic])
  @@index([canonicalSlug])
  @@index([sheetCategory])
}

model UserDsaProgress {
  id                   String     @id @default(uuid())
  userId               String
  problemId            String
  status               String     @default("TODO") // TODO, ATTEMPTED, SOLVED, REVISE
  solutionMode         String?    // INDEPENDENT, WITH_HINTS, WITH_EDITORIAL, WITH_AI, REATTEMPTED, FAILED
  masteryScore         Float      @default(0.0) // 0.0 to 100.0%
  confidenceRating     Int?       // 1 to 5 (SM-2 recall rating)
  repetitionCount      Int        @default(0) // spaced repetition count
  easeFactor           Float      @default(2.5) // SM-2 ease factor
  reviewIntervalDays   Int        @default(1)
  repeatedMistakesJson String?    // JSON array of mistake tags
  attemptsCount        Int        @default(0)
  timeSpentSeconds     Int        @default(0)
  hintUsed             Boolean    @default(false)
  codeSnippet          String?
  notes                String?
  nextReviewDate       DateTime?
  lastSolvedAt         DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem              DsaProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId])
  @@index([status])
  @@index([solutionMode])
  @@index([nextReviewDate])
}

model DsaSheet {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  description   String?
  category      String   // STRIVER_A2Z, TLE_ELIMINATORS, TUF, CUSTOM
  problemsCount Int      @default(0)
  isOfficial    Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([slug])
}

// -------------------------------------------------------------
// DEVELOPER SKILL INTELLIGENCE
// -------------------------------------------------------------

model UserSkillProfile {
  id                   String   @id @default(uuid())
  userId               String
  skillName            String   // e.g. "TypeScript", "React", "Graph Algorithms"
  category             String   // LANGUAGE, FRAMEWORK, DSA, CLOUD
  confidenceScore      Float    @default(0.0) // 0.0 to 100.0
  verifiedEvidenceJson String?  // links to repos, PRs, solved problems
  lastEvaluatedAt      DateTime @default(now())

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillName])
  @@index([userId])
}

model ContributionPipelineItem {
  id          String    @id @default(uuid())
  userId      String
  issueId     String
  stage       String    @default("DISCOVERED") // DISCOVERED, SHORTLISTED, EXPLORING, PREPARING, WORKING, PR_SUBMITTED, MERGED
  prUrl       String?
  priority    String    @default("MEDIUM")     // LOW, MEDIUM, HIGH, URGENT
  notes       String?
  deadline    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue       OssIssue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([userId, issueId])
  @@index([userId])
  @@index([stage])
}

// -------------------------------------------------------------
// SELFBOT AUTOMATION
// -------------------------------------------------------------

model SelfbotConfig {
  id                 String       @id @default(uuid())
  userId             String
  repositoryFullName String
  welcomeMessage     String?
  welcomeEnabled     Boolean      @default(false)
  goodbyeMessage     String?
  goodbyeEnabled     Boolean      @default(false)
  slashCommandsJson  String?      // map of { "/command": "response body" }
  isEnabled          Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs               SelfbotLog[]

  @@unique([userId, repositoryFullName])
  @@index([userId])
}

model SelfbotLog {
  id          String        @id @default(uuid())
  configId    String
  eventType   String        // ISSUE_OPENED, PR_OPENED, COMMAND_TRIGGERED
  triggeredBy String
  actionTaken String
  details     String?
  createdAt   DateTime      @default(now())

  config      SelfbotConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
}

// -------------------------------------------------------------
// COMMUNITY FORUM & MARKETPLACE
// -------------------------------------------------------------

model ForumPost {
  id        String       @id @default(uuid())
  userId    String
  title     String
  content   String
  tagsJson  String?      // JSON array
  upvotes   Int          @default(0)
  views     Int          @default(0)
  isSolved  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies   ForumReply[]

  @@index([userId])
  @@index([createdAt])
}

model ForumReply {
  id               String    @id @default(uuid())
  postId           String
  userId           String
  content          String
  isAcceptedAnswer Boolean   @default(false)
  upvotes          Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  post             ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

model MarketplaceListing {
  id           String   @id @default(uuid())
  userId       String
  title        String
  description  String
  category     String   // COLLABORATION, HIRING, BOUNTY_PROJECT
  projectUrl   String?
  compensation String?
  status       String   @default("OPEN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// -------------------------------------------------------------
// ORBIT AI & ORBIT RECON
// -------------------------------------------------------------

model AiConversation {
  id        String      @id @default(uuid())
  userId    String
  title     String      @default("New Conversation")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([userId])
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String         // system, user, assistant
  content        String
  model          String?
  isFallback     Boolean        @default(false)
  createdAt      DateTime       @default(now())

  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model ReconProject {
  id                      String   @id @default(uuid())
  userId                  String
  targetUrl               String
  name                    String
  fullScreenshotPath      String?
  extractedTokensJson     String?  // colors, typography, spacing
  componentHierarchyJson  String?  // extracted DOM structure
  generatedCode           String?  // React + Tailwind JSX
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// -------------------------------------------------------------
// ORBIT PULSE & NOTIFICATIONS
// -------------------------------------------------------------

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   // OPPORTUNITY, DSA_REVISION, MENTORSHIP_DEADLINE, SYSTEM
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model AlertRule {
  id          String   @id @default(uuid())
  userId      String
  name        String
  queryType   String   // ISSUE_LABEL, REPO_TREND, BOUNTY_ALERT
  filtersJson String   // language, label, minStars, minBounty
  channel     String   @default("DESKTOP") // DESKTOP, TELEGRAM
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
