# ==============================================================================
# DevOrbit API — Environment Configuration Template (.env.example)
# "Your Skills. Your Code. Your Opportunities. One Universe."
#
# INSTRUCTIONS:
# Copy this file to .env inside apps/api/ before starting the backend application:
#   cp .env.example .env
#
# DO NOT COMMIT REAL SECRETS OR ACCESS TOKENS TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# ------------------------------------------------------------------------------
# 2. LOCAL-FIRST DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# SQLite database path for Prisma ORM
DATABASE_URL="file:./devorbit.db"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & CRYPTOGRAPHIC SECRETS
# ------------------------------------------------------------------------------
# JWT signing secret (min 32 characters in production)
# Generate via: openssl rand -hex 32
JWT_SECRET="devorbit_jwt_secret_local_key_change_in_production_2026_min32chars"

# AES-256-GCM authenticated cipher key for encrypting GitHub tokens at rest
# Required: 32 bytes (64 hex characters)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ------------------------------------------------------------------------------
# 4. GITHUB APP / OAUTH CONFIGURATION
# ------------------------------------------------------------------------------
# Register a GitHub OAuth App or GitHub App on github.com/settings/developers
GITHUB_CLIENT_ID="your_github_client_id_here"
GITHUB_CLIENT_SECRET="your_github_client_secret_here"
GITHUB_REDIRECT_URI="http://localhost:5173/integrations"

# ------------------------------------------------------------------------------
# 5. LOCAL AI & OLLAMA CONFIGURATION (OPTIONAL)
# ------------------------------------------------------------------------------
# Local Ollama daemon host (defaults to http://127.0.0.1:11434)
OLLAMA_HOST="http://127.0.0.1:11434"
